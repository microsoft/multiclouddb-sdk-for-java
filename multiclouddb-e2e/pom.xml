<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.microsoft.multiclouddb</groupId>
        <artifactId>multiclouddb-sdk-java-parent</artifactId>
        <version>1-SNAPSHOT</version>
    </parent>

    <artifactId>multiclouddb-e2e</artifactId>
    <name>Multicloud DB E2E Tests</name>
    <description>
        End-to-end portability tests for the Multicloud DB SDK.
        Runs the same CRUD code against Azure Cosmos DB, Amazon DynamoDB, or
        Google Cloud Spanner by switching a single properties file — no code
        changes required.
    </description>

    <dependencies>
        <!-- Public API (compile scope): MulticloudDbClient, QueryRequest, etc. -->
        <dependency>
            <groupId>com.microsoft.multiclouddb</groupId>
            <artifactId>multiclouddb-api</artifactId>
        </dependency>

        <!-- Provider: Azure Cosmos DB (runtime — loaded via ServiceLoader) -->
        <dependency>
            <groupId>com.microsoft.multiclouddb</groupId>
            <artifactId>multiclouddb-provider-cosmos</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Provider: Amazon DynamoDB (runtime — loaded via ServiceLoader) -->
        <dependency>
            <groupId>com.microsoft.multiclouddb</groupId>
            <artifactId>multiclouddb-provider-dynamo</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Provider: Google Cloud Spanner (runtime — loaded via ServiceLoader) -->
        <dependency>
            <groupId>com.microsoft.multiclouddb</groupId>
            <artifactId>multiclouddb-provider-spanner</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Bridge commons-logging (used by AWS / Cosmos SDKs) to SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jcl-over-slf4j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Switch providers by passing -Dmulticlouddb.config=<file>:

                  mvn -pl multiclouddb-e2e process-resources exec:java                                          (Cosmos DB — default)
                  mvn -pl multiclouddb-e2e process-resources exec:java -Dmulticlouddb.config=dynamo.properties
                  mvn -pl multiclouddb-e2e process-resources exec:java -Dmulticlouddb.config=spanner.properties

                Including process-resources ensures *.properties files are copied
                to target/classes/ before the app runs.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>com.microsoft.multiclouddb.e2e.Main</mainClass>
                </configuration>
            </plugin>
            <!-- E2E scenarios are an executable application under src/main and run
                 through exec:java, not Surefire. Skipping Surefire also prevents the
                 parent unit profile's JUnit tag filters from requiring a test engine
                 in this module, which intentionally has no test sources. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
