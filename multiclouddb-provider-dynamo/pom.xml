<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.microsoft.multiclouddb</groupId>
        <artifactId>multiclouddb-sdk-java-parent</artifactId>
        <version>1-SNAPSHOT</version>
    </parent>

    <artifactId>multiclouddb-provider-dynamo</artifactId>
    <version>${multiclouddb-provider-dynamo.version}</version>
    <name>Multicloud DB DynamoDB Provider</name>
    <description>AWS DynamoDB provider adapter for Multicloud DB SDK</description>
    <url>https://github.com/microsoft/multiclouddb-sdk-for-java</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/microsoft/multiclouddb-sdk-for-java</url>
        <connection>scm:git:https://github.com/microsoft/multiclouddb-sdk-for-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/microsoft/multiclouddb-sdk-for-java.git</developerConnection>
    </scm>

    <developers>
        <developer>
            <id>microsoft</id>
            <name>Microsoft Corporation</name>
            <url>https://github.com/microsoft</url>
        </developer>
    </developers>

    <properties>
        <shading.provider>dynamo</shading.provider>
        <shading.prefix>com.multiclouddb.shaded.dynamo</shading.prefix>
        <shading.nativePrefix>com_multiclouddb_shaded_dynamo</shading.nativePrefix>
        <shading.moduleInfo>
            module com.multiclouddb.provider.dynamo {
                requires com.multiclouddb.api;
                requires org.slf4j;
                requires java.logging;
                requires java.management;
                requires java.naming;
                requires java.security.jgss;
                requires java.xml;
                requires jdk.unsupported;
                uses com.multiclouddb.shaded.dynamo.software.amazon.awssdk.http.SdkHttpService;
                uses com.multiclouddb.shaded.dynamo.io.netty.bootstrap.ChannelInitializerExtension;
                uses com.multiclouddb.shaded.dynamo.software.amazon.awssdk.http.async.SdkAsyncHttpService;
                uses com.multiclouddb.shaded.dynamo.software.amazon.awssdk.thirdparty.jackson.core.JsonFactory;
                provides com.multiclouddb.spi.MulticloudDbProviderAdapter
                    with com.multiclouddb.provider.dynamo.DynamoProviderAdapter;
                provides com.multiclouddb.shaded.dynamo.software.amazon.awssdk.http.SdkHttpService
                    with com.multiclouddb.shaded.dynamo.software.amazon.awssdk.http.apache.ApacheSdkHttpService;
                provides com.multiclouddb.shaded.dynamo.software.amazon.awssdk.http.async.SdkAsyncHttpService
                    with com.multiclouddb.shaded.dynamo.software.amazon.awssdk.http.nio.netty.NettySdkAsyncHttpService;
                provides com.multiclouddb.shaded.dynamo.software.amazon.awssdk.thirdparty.jackson.core.JsonFactory
                    with com.multiclouddb.shaded.dynamo.software.amazon.awssdk.thirdparty.jackson.core.JsonFactory;
            }
        </shading.moduleInfo>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.microsoft.multiclouddb</groupId>
            <artifactId>multiclouddb-api</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
        </dependency>
        <!-- Default credentials discover these factories by name. Application SDK
             modules cannot satisfy those lookups after provider-local relocation. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
            <version>${aws-sdk.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sso</artifactId>
            <version>${aws-sdk.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ssooidc</artifactId>
            <version>${aws-sdk.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>CHANGELOG.md</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration><forceCreation>true</forceCreation></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Byte Buddy (used by Mockito) does not officially support
                         Java versions beyond 22. Enable experimental mode so that
                         DynamoDbException (and other AWS SDK exception classes)
                         can be mocked on Java 23+.
                         JPMS: allow the named module to read test-scoped
                         dependencies (logback, Mockito) and allow reflective
                         access for Mockito. -->
                    <argLine>
                        -Dnet.bytebuddy.experimental=true
                        --add-reads com.multiclouddb.provider.dynamo=ALL-UNNAMED
                        --add-reads com.multiclouddb.provider.dynamo=ch.qos.logback.classic
                        --add-reads com.multiclouddb.provider.dynamo=ch.qos.logback.core
                        --add-opens com.multiclouddb.provider.dynamo/com.multiclouddb.provider.dynamo=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
